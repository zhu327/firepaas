# syntax=docker/dockerfile:1
#
# edge-proxy（边缘流量入口）生产镜像：静态二进制 + distroless nonroot。
# iac/nomad/edge.hcl 的 docker driver 以不可变 digest 引用本镜像；该 job 以
# host network 监听 :80/:443，因此任务 config 必须附带
# cap_add = ["NET_BIND_SERVICE"]（非 root 绑定特权端口的内核能力，不放宽
# 其它权限）。若某环境无法授予该能力，退回 task user = "root" 并重新评审。
#
# 本地可用 --build-arg GOLANG_IMAGE=<mirror>/golang:1.25 覆盖构建基座；
# CI 使用下方默认的版本钉扎官方镜像。
ARG GOLANG_IMAGE=golang:1.25.4-bookworm

FROM ${GOLANG_IMAGE} AS build
WORKDIR /src
# 先拷依赖清单利用层缓存；hypeman 经 go.mod replace 指向公开 fork tag，
# 无需 sibling checkout。GOWORK=off 走根 go.mod（与 CI 一致）。
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    GOWORK=off go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOWORK=off go build -trimpath -ldflags='-s -w' \
      -o /out/edge-proxy ./cmd/edge-proxy

# distroless/static-debian12:nonroot（多架构 index digest，2026-09 实测）。
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/edge-proxy /edge-proxy
USER 65532:65532
EXPOSE 80 443
ENTRYPOINT ["/edge-proxy"]
