# firepaas 环境变量示例。值均为本地开发占位；生产环境必须由受保护的
# Nomad/Vault 模板注入，不得复用这里的口令或关闭认证/mTLS。

# ---- 控制面 ----
FIREPAAS_HTTP_PORT=8080
# API 默认要求 Bearer token；生产值必须为高熵 secret。
FIREPAAS_API_TOKEN=dev-only-change-me
# secrets/traffic keys 必须为 base64 编码的至少 32 字节随机值。
FIREPAAS_SECRETS_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
FIREPAAS_TRAFFIC_TOKEN_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
FIREPAAS_POSTGRES_URL=postgres://firepaas:firepaas@127.0.0.1:5432/firepaas?sslmode=disable
# edge 也依赖此值(读 route catalog);生产环境由 Nomad template/Vault 注入
FIREPAAS_REDIS_ADDR=127.0.0.1:6379
FIREPAAS_NOMAD_ADDR=http://127.0.0.1:4646
FIREPAAS_REGISTRY=127.0.0.1:5000  # 共享 OCI registry(实验室 registry:2,见 iac/README)

# ---- 镜像 GC ----
# 默认 dry-run；仅在完整 PG roots、agent live roots 和 agent 侧在用保护均可用时删除。
# Local artifact GC is off by default. dry-run reports candidates; delete still
# requires an agent quarantine capability and otherwise fails closed.
FIREPAAS_LOCAL_GC_MODE=off
FIREPAAS_LOCAL_GC_GRACE=10m
# Snapshot scrub is disabled until IO-budget evidence is reviewed.
FIREPAAS_SCRUB_ENABLED=false
FIREPAAS_SCRUB_INTERVAL=1h
FIREPAAS_SCRUB_BUDGET=1
FIREPAAS_GC_MIN_AGE=1h
FIREPAAS_GC_HIGH_WATERMARK=0.85
FIREPAAS_GC_LOW_WATERMARK=0.70
FIREPAAS_GC_INTERVAL=5m

# ---- 保留期 ----
# 租户事件与调度/对账事件的在表保留期（默认 168h，上限 720h）。
FIREPAAS_USER_EVENTS_RETENTION=168h
FIREPAAS_SCHEDULER_EVENTS_RETENTION=168h

# ---- 调度器 ----
# 镜像亲和权重（v1.1/ADR-0018）：默认 0.5；设为 0 显式关闭亲和打分。
# Best-of-K 的 R/K/α 由 scheduler.DefaultBestOfKConfig() 固定，当前无 env 入口。
FIREPAAS_SCHED_WEIGHT_IMAGE=0.5

# ---- agent ----
FIREPAAS_AGENT_GRPC_PORT=5108
FIREPAAS_AGENT_PROXY_PORT=5107
FIREPAAS_AGENT_DATA_DIR=/var/lib/firepaas
# 生产必须同时提供 mTLS 三件套；5108 仅允许 control-plane，5107 仅允许 edge。
FIREPAAS_AGENT_TLS_CERT=/run/secrets/agentd.crt
FIREPAAS_AGENT_TLS_KEY=/run/secrets/agentd.key
FIREPAAS_AGENT_TLS_CA=/run/secrets/ca.crt
FIREPAAS_AGENT_GRPC_ALLOWED_CLIENTS=control-plane
FIREPAAS_AGENT_PROXY_ALLOWED_CLIENTS=edge-proxy
FIREPAAS_PROXY_CREDENTIAL_REQUIRED=true
# v1.2-A（ADR-0023）：agent runtime capability 减法 allowlist（逗号分隔）。
# 省略时上报当前运行模式真实支持的能力；设置后只能移除能力，不能伪造能力。
# secret.oneshot.v1 仅 FIREPAAS_SECRET_INJECTION=oneshot 时可能上报；
# unsafe-persisted-env、off/空值及未知模式均 fail closed。
# FIREPAAS_SECRET_INJECTION=oneshot
# FIREPAAS_AGENT_FEATURE_IDS=guest.exec.v1,guest.copy.v1,guest.logs.v1,secret.oneshot.v1
# v1.2-C（ADR-0025）：guest 运维通道会话限制（默认 16 会话 / 100MiB / 15min / 60s 空闲）。
# FIREPAAS_RUNTIME_MAX_SESSIONS=16
# FIREPAAS_RUNTIME_MAX_BYTES=104857600
# FIREPAAS_RUNTIME_MAX_DURATION=15m
# FIREPAAS_RUNTIME_IDLE_TIMEOUT=60s
# W3.2：Exec/CopyTo 节点总开关（默认启用）。=0 时两者直接 PermissionDenied，
# 且不再上报 guest.exec.v1/guest.copy.v1（控制面 409 而不是 502）。
# FIREPAAS_AGENT_ALLOW_EXEC=1
# W3.3：fabric ingress（:5109）凭证回查限流（全节点 lookup 上限 / 未命中上限，
# 命中不受未命中桶影响）。
# FIREPAAS_AGENT_INGRESS_LOOKUP_RPS=1000
# FIREPAAS_AGENT_INGRESS_MISS_RPS=50

# ---- edge ----
FIREPAAS_EDGE_PORT=80
# api job 以 provider=consul 注册；需主机 resolver 转发 .consul 到 127.0.0.1:8600，
# 未配置时临时使用静态 HTTP API 地址（见 iac/README.md 服务发现）。
FIREPAAS_API_ADDR=http://firepaas-api.service.consul:8080
FIREPAAS_EDGE_TLS_LISTEN=:443
FIREPAAS_EDGE_TLS_CERT=/run/secrets/edge-client.crt
FIREPAAS_EDGE_TLS_KEY=/run/secrets/edge-client.key
FIREPAAS_EDGE_TLS_CA=/run/secrets/ca.crt
FIREPAAS_EDGE_SERVER_CERT=/run/secrets/edge-server.crt
FIREPAAS_EDGE_SERVER_KEY=/run/secrets/edge-server.key
# W3.3：token 回源 TLS。默认不强制（仓库内 API 只有明文监听 + 启动告警）；
# API 侧终结 TLS 后置 true 收紧为 fail-closed，私有 CA 经 API_CA 注入。
# FIREPAAS_EDGE_API_REQUIRE_TLS=true
# FIREPAAS_EDGE_API_CA=/run/secrets/api-ca.crt
# W1.1：metrics 默认只绑 loopback；跨主机抓取显式绑 0.0.0.0 并以 ACL 限源，
# 非空 METRICS_TOKEN 启用 Bearer 鉴权，LABEL_MACHINE=0 关闭 per-machine 标签。
# FIREPAAS_EDGE_METRICS_BIND=0.0.0.0
# FIREPAAS_EDGE_METRICS_TOKEN=
# FIREPAAS_EDGE_METRICS_LABEL_MACHINE=1
# ADR-0041 并发弹性信号（edge 5s 上报 autoscale:{host}，TTL 20s；上报间隔
# 不得超过 TTL 一半，超限会被钳制并告警；EWMA 系数随间隔自动推导）。
# FIREPAAS_EDGE_AUTOSCALE_INTERVAL=5s
# FIREPAAS_EDGE_AUTOSCALE_MAX_HOSTS=10000
# FIREPAAS_EDGE_ID=edge-hub
# 控制器决策节拍与配额冻结（默认 10s / 100s；冻结超时自动解冻重探）。
# FIREPAAS_AUTOSCALE_INTERVAL=10s
# FIREPAAS_AUTOSCALE_QUOTA_FREEZE=100s
