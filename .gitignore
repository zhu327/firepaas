# Binaries
/bin/
**/bin/
# go build ./... 落产物到仓库根（agentd/cni-firepaas 等，不误入库）
/cni-firepaas
/agentd
/edge-proxy
/firepaas-api
/fpctl
/agentctl

# Env / secrets
.env
.env.*
!.env.example

# Local data (agents, caddy, vm data)
/data/
/var/lib/firepaas/
scripts/lab/certs/

# Go
vendor/
*.test
*.out

# Local dev workspace for unpublished hypeman changes (kept outside version
# control per the root go.work comment; CI and releases always use GOWORK=off).
go.work.local
go.work.local.sum

# Codegen
# Generated protobuf code is committed: CI diffs it to enforce contract generation.
# Do not ignore shared/gen/.

# Terraform
iac/terraform/**/.terraform/
iac/terraform/**/*.tfstate*
iac/terraform/**/*.tfvars

# Editors
.idea/
.vscode/
.DS_Store

# Built command binaries (usually built via scripts/lab into ~/.local/firepaas-lab)
/agentd
/api
/edge-proxy
/m0-spike

# Local lab caches, benchmark/e2e output and non-versioned acceptance logs
scripts/lab/.cache/
scripts/lab/__pycache__/
scripts/lab/results/
scripts/results/

# Local agent workflow config (kept out of the published repository)
.agents/
.pi/
AGENTS.md
# go build 直接把 cmd/api 目录作为包输出时落在 cmd/api/api（不误入库）
cmd/api/api
